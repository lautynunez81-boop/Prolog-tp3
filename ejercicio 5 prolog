
% Ejercicio 5 - Operaciones logicas

% AND
and(0,0,0).
and(0,1,0).
and(1,0,0).
and(1,1,1).

% OR
or(0,0,0).
or(0,1,1).
or(1,0,1).
or(1,1,1).

% NOT
not(0,1).
not(1,0).

% Regla del circuito

circuito(Q1,Q2,S):-
    not(Q1,N1),
    not(Q2,N2),
    and(N1,Q2,A),
    and(Q1,N2,B),
    or(A,B,S).
